# Third-party reference sources.
#
# These are Trae-Relay's C++ sources, downloaded only to read the wire protocol
# out of them (see PROTOCOL.md). The upstream repository ships NO LICENSE, so
# they must never be redistributed or committed.
reference/

# Publish artifacts and installed dependencies
*.tgz
node_modules/

# Local scratch
.DS_Store
__pycache__/
*.log
.tmp/
.gateway/
*.db
*.db-wal
*.db-shm

# Pending the `workflow` OAuth scope on the pushing account: the token used by
# `gh` may not create or update workflow files, and a plain `git add -A` would
# then fail the push with "refusing to allow an OAuth App to create or update
# workflow". Remove this line (and push the file) once the scope is granted:
#   gh auth refresh -s workflow
.github/workflows/check.yml
