{
  "name": "trae-cn-provider",
  "version": "0.2.1",
  "private": false,
  "type": "module",
  "description": "Trae CN as a native DeepSeek Harness LLM provider: browser OAuth login by default, optional local-install credential source, OpenAI-compatible surface on the host web server",
  "license": "MIT",
  "author": "jjjason <lingjie199302@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JsonLing/trae-cn-provider.git"
  },
  "homepage": "https://github.com/JsonLing/trae-cn-provider#readme",
  "bugs": {
    "url": "https://github.com/JsonLing/trae-cn-provider/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/adapter.js",
    "lib/attachments.js",
    "lib/attribution.js",
    "lib/chat-body.js",
    "lib/credentials.js",
    "lib/llm.js",
    "lib/messages.js",
    "lib/support.js",
    "src/env.js",
    "src/trae-auth.js",
    "src/trae-client.js",
    "src/trae-local-credentials.js",
    "src/openai-server.js",
    "src/quota.js",
    "src/cli.js",
    "cordis.patch.yml",
    "README.md",
    "SECURITY.md",
    "src/store.js",
    "src/admin.js"
  ],
  "bin": {
    "trae-cn": "src/cli.js"
  },
  "scripts": {
    "login": "node src/cli.js login",
    "models": "node src/cli.js models",
    "serve": "node src/cli.js serve",
    "chat": "node src/cli.js chat",
    "usage": "node src/cli.js usage",
    "gateway:init": "node src/cli.js init",
    "gateway": "node src/cli.js serve --config \"$HOME/.trae-proxy/gateway.json\"",
    "gateway:deepseek": "node src/cli.js serve --host 0.0.0.0 --port 8317 --db \"$PWD/.gateway/gateway.db\" --default-model DeepSeek-V4.1-Flash-1017 --admin-password \"${ADMIN_PASSWORD:?先 export ADMIN_PASSWORD}\"",
    "gateway:local": "node src/cli.js serve --host 0.0.0.0 --port 8317 --db \"$PWD/.gateway/gateway.db\" --admin-password \"${ADMIN_PASSWORD:?先 export ADMIN_PASSWORD，或用 npm run gateway:init}\"",
    "gateway:stop": "node src/cli.js stop",
    "keys": "node src/cli.js keys list",
    "keys:add": "node src/cli.js keys add",
    "report": "node src/cli.js report",
    "report:7d": "node src/cli.js report --days 7",
    "check": "bash test/check.sh",
    "test": "node test/smoke-adapter.js && node test/smoke-client.js && node test/smoke-plugin.js && node test/smoke-login.js && node test/smoke-quota.js && node test/smoke-gateway.js",
    "prepublishOnly": "npm run check"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.1.2-rc.1": "compatible",
        "0.2.0-rc.2": "compatible",
        "0.2.1-alpha.2": "compatible"
      }
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "trae",
    "trae-cn",
    "llm",
    "provider"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-credentials": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-credentials": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-launch-environment": ">=0.1.2-rc.1",
    "@deepseek-ai/cordis-plugin-loader": "~1.0.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/cordis-plugin-loader": {
      "optional": true
    },
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    },
    "@deepseek-ai/dsh-launch-environment": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  }
}
